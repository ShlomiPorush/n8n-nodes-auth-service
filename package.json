{
  "name": "n8n-nodes-auth-service",
  "version": "0.5.0",
  "description": "n8n community node to validate tokens against an Auth Service instance",
  "keywords": [
    "n8n-community-node-package",
    "n8n",
    "auth",
    "token",
    "validate"
  ],
  "license": "MIT",
  "author": "Shlomi Porush",
  "main": "dist/nodes/AuthService/AuthService.node.js",
  "scripts": {
    "build": "tsc && node -e \"const fs=require('fs');const p=require('path');['AuthService','AuthWebhook','RespondToAuthWebhook'].forEach(n=>{fs.mkdirSync(p.join('dist','nodes',n),{recursive:true})});fs.cpSync(p.join('nodes','AuthService','authservice.svg'),p.join('dist','nodes','AuthService','authservice.svg'));fs.cpSync(p.join('nodes','AuthWebhook','authwebhook.svg'),p.join('dist','nodes','AuthWebhook','authwebhook.svg'));fs.cpSync(p.join('nodes','RespondToAuthWebhook','respondtoauthwebhook.svg'),p.join('dist','nodes','RespondToAuthWebhook','respondtoauthwebhook.svg'));\"",
    "dev": "tsc --watch",
    "lint": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "files": [
    "dist"
  ],
  "n8n": {
    "n8nNodesApiVersion": 1,
    "credentials": [
      "dist/credentials/AuthServiceApi.credentials.js"
    ],
    "nodes": [
      "dist/nodes/AuthService/AuthService.node.js",
      "dist/nodes/AuthWebhook/AuthWebhook.node.js",
      "dist/nodes/RespondToAuthWebhook/RespondToAuthWebhook.node.js"
    ]
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "n8n-workflow": "*",
    "typescript": "~5.5.0"
  },
  "peerDependencies": {
    "n8n-workflow": "*"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ShlomiPorush/n8n-nodes-auth-service"
  }
}